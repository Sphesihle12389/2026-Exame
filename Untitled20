    {
      "cell_type": "code",
      "source": [
        "\n",
        "ward_party_shares = (\n",
        "    historical\n",
        "    .groupby([\"ward\", \"party\", \"election_year\"], as_index=False)[\"vote_share\"]\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "\n",
        "lag_features = ward_party_shares.pivot(\n",
        "    index=[\"ward\", \"party\"],\n",
        "    columns=\"election_year\",\n",
        "    values=\"vote_share\"\n",
        ").reset_index()\n",
        "\n",
        "\n",
        "lag_features.columns.name = None\n",
        "lag_features = lag_features.rename(columns={\n",
        "    2011: \"share_2011\",\n",
        "    2016: \"share_2016\",\n",
        "    2021: \"share_2021\"\n",
        "}).fillna(0.0)\n",
        "\n",
        "lag_features[\"growth_2016_2021\"] = lag_features[\"share_2021\"] - lag_features[\"share_2016\"]\n",
        "\n",
        "print(\"Lagged feature matrix created successfully:\")\n",
        "display(lag_features.head(10))"
